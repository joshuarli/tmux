#!/bin/sh
# configure - generate config.h and build.ninja for tmux (macOS and Linux).
# No autotools required. Runs in under a second.
set -e

die() { printf 'error: %s\n' "$1" >&2; exit 1; }

# Defaults.
CC="${CC:-cc}"
PKG_CONFIG="${PKG_CONFIG:-pkg-config}"
YACC="${YACC:-yacc}"
PREFIX="${PREFIX:-/usr/local}"
SYSCONFDIR="${SYSCONFDIR:-/etc}"
ENABLE_DEBUG=no

# Parse options.
for arg; do
	case "$arg" in
		--prefix=*) PREFIX="${arg#*=}" ;;
		--sysconfdir=*) SYSCONFDIR="${arg#*=}" ;;
		--enable-debug) ENABLE_DEBUG=yes ;;
		-h|--help)
			cat <<'EOF'
Usage: ./configure [OPTIONS]

  --prefix=DIR            installation prefix [/usr/local]
  --sysconfdir=DIR        system config directory [/etc]
  --enable-debug          enable debug build flags

Environment: CC, CFLAGS, LDFLAGS, PKG_CONFIG, YACC
EOF
			exit 0 ;;
		*) die "unknown option: $arg" ;;
	esac
done

# Detect OS.
OS=$(uname -s)
case "$OS" in
	Darwin|Linux) ;;
	*) die "unsupported OS: $OS (Darwin and Linux are supported)" ;;
esac

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

# Check tools.
command -v "$CC" >/dev/null 2>&1 || die "compiler not found: $CC"
command -v "$PKG_CONFIG" >/dev/null 2>&1 || {
	if [ "$OS" = Darwin ]; then
		die "pkg-config not found (brew install pkg-config)"
	else
		die "pkg-config not found (apt-get install pkg-config)"
	fi
}
command -v ninja >/dev/null 2>&1 || {
	if [ "$OS" = Darwin ]; then
		die "ninja not found (brew install ninja)"
	else
		die "ninja not found (apt-get install ninja-build)"
	fi
}

if ! command -v "$YACC" >/dev/null 2>&1; then
	if command -v bison >/dev/null 2>&1; then
		YACC="bison -y"
	else
		if [ "$OS" = Darwin ]; then
			die "yacc not found (xcode-select --install)"
		else
			die "yacc not found (apt-get install bison)"
		fi
	fi
fi

# Version from configure.ac.
VERSION=$(sed -n 's/^AC_INIT(\[tmux\], *\(.*\))/\1/p' configure.ac)
test -n "$VERSION" || die "cannot parse version from configure.ac"
printf 'tmux %s (%s)\n\n' "$VERSION" "$OS"

# Detect libevent.
if $PKG_CONFIG --exists "libevent_core >= 2" 2>/dev/null; then
	LIBEVENT_CFLAGS=$($PKG_CONFIG --cflags libevent_core)
	LIBEVENT_LIBS=$($PKG_CONFIG --libs libevent_core)
	printf 'libevent: %s\n' "$($PKG_CONFIG --modversion libevent_core)"
elif $PKG_CONFIG --exists "libevent >= 2" 2>/dev/null; then
	LIBEVENT_CFLAGS=$($PKG_CONFIG --cflags libevent)
	LIBEVENT_LIBS=$($PKG_CONFIG --libs libevent)
	printf 'libevent: %s\n' "$($PKG_CONFIG --modversion libevent)"
else
	if [ "$OS" = Darwin ]; then
		die "libevent >= 2 not found (brew install libevent)"
	else
		die "libevent >= 2 not found (apt-get install libevent-dev)"
	fi
fi

# Detect utf8proc.
if $PKG_CONFIG --exists libutf8proc 2>/dev/null; then
	UTF8PROC_CFLAGS=$($PKG_CONFIG --cflags libutf8proc)
	UTF8PROC_LIBS=$($PKG_CONFIG --libs libutf8proc)
	printf 'utf8proc: %s\n' "$($PKG_CONFIG --modversion libutf8proc)"
else
	if [ "$OS" = Darwin ]; then
		die "utf8proc not found (brew install utf8proc)"
	else
		die "utf8proc not found (apt-get install libutf8proc-dev)"
	fi
fi

# Compile test helper. Optional $1: extra libraries.
try_compile() {
	_extra="${1:-}"
	cat > "$TMPDIR/test.c"
	# shellcheck disable=SC2086
	$CC $LIBEVENT_CFLAGS \
		-o "$TMPDIR/test" "$TMPDIR/test.c" \
		$LIBEVENT_LIBS $_extra 2>/dev/null
}

# Test for reallocarray (missing on older glibc and older macOS).
HAVE_REALLOCARRAY=no
if printf '#include <stdlib.h>\nint main(void){return reallocarray(NULL,1,1)==NULL;}' \
		| try_compile; then
	HAVE_REALLOCARRAY=yes
fi

# Test for TAILQ_CONCAT in sys/queue.h.
HAVE_QUEUE_H=no
if cat <<'QEOF' | try_compile
#include <sys/queue.h>
TAILQ_HEAD(test_head, test_entry);
struct test_entry { TAILQ_ENTRY(test_entry) entries; };
int main(void) {
	struct test_head h1, h2;
	TAILQ_INIT(&h1); TAILQ_INIT(&h2);
	TAILQ_CONCAT(&h1, &h2, entries);
	return 0;
}
QEOF
then
	HAVE_QUEUE_H=yes
fi

# Platform-specific detection.
LIBS_EXTRA=""

if [ "$OS" = Darwin ]; then
	# All these are known-present on macOS; no probing needed.
	HAVE_B64_NTOP=yes
	HAVE_CLOSEFROM=no
	HAVE_EXPLICIT_BZERO=no
	HAVE_FGETLN=yes
	HAVE_FORKPTY=yes
	HAVE_GETPEEREID=yes
	HAVE_GETPROGNAME=yes
	HAVE_PROC_PIDINFO=yes
	HAVE_STRLCAT=yes
	HAVE_STRLCPY=yes
	HAVE_STRTONUM=yes
	HAVE_SYS_SIGNAME=yes
	HAVE_SO_PEERCRED=no
	LIBS_EXTRA="-lresolv"
	OSDEP="osdep-darwin.c"
	EXTRA_COMPAT="compat/daemon-darwin.c"
else
	# Linux: probe what may be absent or differ from glibc to glibc.

	# b64_ntop: try without -lresolv first, then with.
	HAVE_B64_NTOP=no
	if printf '#include <netinet/in.h>\n#include <resolv.h>\nint main(void){return b64_ntop(0,0,0,0);}' \
			| try_compile; then
		HAVE_B64_NTOP=yes
	elif printf '#include <netinet/in.h>\n#include <resolv.h>\nint main(void){return b64_ntop(0,0,0,0);}' \
			| try_compile "-lresolv"; then
		HAVE_B64_NTOP=yes
		LIBS_EXTRA="$LIBS_EXTRA -lresolv"
	fi

	# closefrom: glibc >= 2.34.
	HAVE_CLOSEFROM=no
	if printf '#include <unistd.h>\nint main(void){closefrom(3);return 0;}' \
			| try_compile; then
		HAVE_CLOSEFROM=yes
	fi

	# explicit_bzero: glibc >= 2.25.
	HAVE_EXPLICIT_BZERO=no
	if printf '#include <string.h>\nint main(void){explicit_bzero("",0);return 0;}' \
			| try_compile; then
		HAVE_EXPLICIT_BZERO=yes
	fi

	# strlcpy / strlcat: glibc >= 2.38.
	HAVE_STRLCPY=no
	if printf '#include <string.h>\nint main(void){char b[1];strlcpy(b,"",1);return 0;}' \
			| try_compile; then
		HAVE_STRLCPY=yes
	fi
	HAVE_STRLCAT=no
	if printf '#include <string.h>\nint main(void){char b[1];strlcat(b,"",1);return 0;}' \
			| try_compile; then
		HAVE_STRLCAT=yes
	fi

	# forkpty: in -lutil on Linux.
	HAVE_FORKPTY=no
	if printf '#include <pty.h>\nint main(void){forkpty(0,0,0,0);return 0;}' \
			| try_compile "-lutil"; then
		HAVE_FORKPTY=yes
		LIBS_EXTRA="$LIBS_EXTRA -lutil"
	fi

	# These BSD functions are absent on Linux.
	HAVE_FGETLN=no
	HAVE_GETPEEREID=no
	HAVE_GETPROGNAME=no
	HAVE_PROC_PIDINFO=no
	HAVE_STRTONUM=no
	HAVE_SYS_SIGNAME=no
	HAVE_SO_PEERCRED=yes

	OSDEP="osdep-linux.c"
	EXTRA_COMPAT=""
fi

printf '\n'

# Generate config.h.
write_define() { printf '#define %s 1\n' "$1"; }
{
	printf '/* Generated by ./configure. Do not edit. */\n'
	printf '#ifndef CONFIG_H\n#define CONFIG_H\n\n'

	if [ "$OS" = Darwin ]; then
		# Headers always present on macOS.
		for h in BITSTRING_H DIRENT_H ERR_H EVENT2_EVENT_H FCNTL_H \
			 INTTYPES_H LIBPROC_H PATHS_H STDINT_H UTIL_H; do
			write_define "HAVE_$h"
		done
		printf '\n'

		# macOS-specific workarounds.
		write_define BROKEN___DEAD
		write_define BROKEN_CMSG_FIRSTHDR
		printf '\n'

		# Functions always present on macOS.
		for f in ASPRINTF CFMAKERAW CLOCK_GETTIME DAEMON DIRFD \
			 FLOCK GETDTABLESIZE GETLINE MEMMEM SETENV \
			 STRCASESTR STRNDUP STRNLEN STRSEP SYSCONF __PROGNAME; do
			write_define "HAVE_$f"
		done
	else
		# Required for wcwidth, getline, and other POSIX/GNU extensions.
		printf '#define _GNU_SOURCE 1\n\n'

		# Headers always present on Linux.
		for h in DIRENT_H ERR_H EVENT2_EVENT_H FCNTL_H \
			 INTTYPES_H PATHS_H PTY_H STDINT_H; do
			write_define "HAVE_$h"
		done
		printf '\n'

		# Functions always present on modern Linux (glibc + _GNU_SOURCE via -std=gnu99).
		for f in ASPRINTF CFMAKERAW CLOCK_GETTIME DAEMON DIRFD \
			 FLOCK GETDTABLESIZE GETLINE MEMMEM SETENV \
			 STRCASESTR STRNDUP STRNLEN STRSEP SYSCONF \
			 PROC_PID PRCTL PR_SET_NAME __PROGNAME; do
			write_define "HAVE_$f"
		done
	fi
	test "$HAVE_QUEUE_H" = yes && write_define HAVE_QUEUE_H
	printf '\n'

	# Results from probes (logic is the same; values differ by platform).
	test "$HAVE_REALLOCARRAY" = yes && write_define HAVE_REALLOCARRAY
	test "$HAVE_B64_NTOP" = yes && write_define HAVE_B64_NTOP
	test "$HAVE_CLOSEFROM" = yes && write_define HAVE_CLOSEFROM
	test "$HAVE_EXPLICIT_BZERO" = yes && write_define HAVE_EXPLICIT_BZERO
	test "$HAVE_FGETLN" = yes && write_define HAVE_FGETLN
	test "$HAVE_FORKPTY" = yes && write_define HAVE_FORKPTY
	test "$HAVE_GETPEEREID" = yes && write_define HAVE_GETPEEREID
	test "$HAVE_GETPROGNAME" = yes && write_define HAVE_GETPROGNAME
	test "$HAVE_PROC_PIDINFO" = yes && write_define HAVE_PROC_PIDINFO
	test "$HAVE_STRLCAT" = yes && write_define HAVE_STRLCAT
	test "$HAVE_STRLCPY" = yes && write_define HAVE_STRLCPY
	test "$HAVE_STRTONUM" = yes && write_define HAVE_STRTONUM
	test "$HAVE_SYS_SIGNAME" = yes && write_define HAVE_SYS_SIGNAME
	test "$HAVE_SO_PEERCRED" = yes && write_define HAVE_SO_PEERCRED
	printf '\n'

	# Required features.
	write_define HAVE_UTF8PROC

	printf '\n#endif /* CONFIG_H */\n'
} > config.h
printf 'generated config.h\n'

# Compiler flags.
CFLAGS_BASE="-std=gnu99 -include config.h -iquote."
if [ "$ENABLE_DEBUG" = yes ]; then
	CFLAGS_BASE="$CFLAGS_BASE -O0 -g -DDEBUG"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-long-long -Wall -W -Wformat=2"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-use-after-free"
	CFLAGS_BASE="$CFLAGS_BASE -Wmissing-prototypes -Wstrict-prototypes"
	CFLAGS_BASE="$CFLAGS_BASE -Wmissing-declarations -Wwrite-strings"
	CFLAGS_BASE="$CFLAGS_BASE -Wshadow -Wpointer-arith -Wsign-compare"
	CFLAGS_BASE="$CFLAGS_BASE -Wundef -Wbad-function-cast -Winline"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-cast-align -Wdeclaration-after-statement"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-pointer-sign -Wno-attributes"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-unused-result -Wno-format-y2k"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-unknown-warning-option"
	CFLAGS_BASE="$CFLAGS_BASE -Wno-maybe-uninitialized"
else
	CFLAGS_BASE="$CFLAGS_BASE -O2"
fi
CFLAGS_BASE="$CFLAGS_BASE -Wno-deprecated-declarations -Wno-macro-redefined"
CFLAGS_BASE="$CFLAGS_BASE ${CFLAGS:-}"

CPPFLAGS_ALL="$LIBEVENT_CFLAGS $UTF8PROC_CFLAGS"
CPPFLAGS_ALL="$CPPFLAGS_ALL ${CPPFLAGS:-}"

TMUX_DEFS="-DTMUX_VERSION='\"$VERSION\"'"
TMUX_DEFS="$TMUX_DEFS -DTMUX_CONF='\"$SYSCONFDIR/tmux.conf:~/.tmux.conf:\$\$XDG_CONFIG_HOME/tmux/tmux.conf:~/.config/tmux/tmux.conf\"'"
TMUX_DEFS="$TMUX_DEFS -DTMUX_LOCK_CMD='\"lock -np\"'"
TMUX_DEFS="$TMUX_DEFS -DTMUX_TERM='\"tmux-256color\"'"

LIBS_ALL="$LIBEVENT_LIBS $UTF8PROC_LIBS $LIBS_EXTRA -lm"
LDFLAGS_ALL="${LDFLAGS:-}"

# Source file lists.
CORE_SOURCES="
alerts.c arguments.c attributes.c cfg.c client.c cmd.c colour.c
control.c control-notify.c environ.c file.c format.c format-draw.c
grid.c grid-reader.c grid-view.c hyperlinks.c input.c input-keys.c
job.c key-bindings.c key-string.c layout.c layout-custom.c layout-set.c
log.c menu.c mode-tree.c names.c notify.c options.c options-table.c
paste.c popup.c proc.c regsub.c resize.c screen.c screen-redraw.c
screen-write.c server.c server-acl.c server-client.c server-fn.c
session.c sort.c spawn.c status.c style.c tmux.c tty.c tty-acs.c
tty-draw.c tty-features.c tty-keys.c tty-term.c utf8.c utf8-combined.c
window.c window-buffer.c window-client.c window-clock.c window-copy.c
window-customize.c window-tree.c xmalloc.c
cmd-attach-session.c cmd-bind-key.c cmd-break-pane.c cmd-capture-pane.c
cmd-choose-tree.c cmd-command-prompt.c cmd-confirm-before.c cmd-copy-mode.c
cmd-detach-client.c cmd-display-menu.c cmd-display-message.c
cmd-display-panes.c cmd-find.c cmd-find-window.c cmd-if-shell.c
cmd-join-pane.c cmd-kill-pane.c cmd-kill-server.c cmd-kill-session.c
cmd-kill-window.c cmd-list-buffers.c cmd-list-clients.c cmd-list-commands.c
cmd-list-keys.c cmd-list-panes.c cmd-list-sessions.c cmd-list-windows.c
cmd-load-buffer.c cmd-lock-server.c cmd-move-window.c cmd-new-session.c
cmd-new-window.c cmd-paste-buffer.c cmd-pipe-pane.c cmd-queue.c
cmd-refresh-client.c cmd-rename-session.c cmd-rename-window.c
cmd-resize-pane.c cmd-resize-window.c cmd-respawn-pane.c
cmd-respawn-window.c cmd-rotate-window.c cmd-run-shell.c cmd-save-buffer.c
cmd-select-layout.c cmd-select-pane.c cmd-select-window.c cmd-send-keys.c
cmd-server-access.c cmd-set-buffer.c cmd-set-environment.c cmd-set-option.c
cmd-show-environment.c cmd-show-messages.c cmd-show-options.c
cmd-show-prompt-history.c cmd-source-file.c cmd-split-window.c
cmd-swap-pane.c cmd-swap-window.c cmd-switch-client.c cmd-unbind-key.c
cmd-wait-for.c
"

# Compat sources always compiled.
COMPAT_SOURCES="
compat/closefrom.c
compat/daemon.c
compat/fdforkpty.c
compat/freezero.c
compat/getdtablecount.c
compat/getopt_long.c
compat/htonll.c
compat/imsg.c
compat/imsg-buffer.c
compat/ntohll.c
compat/recallocarray.c
compat/setproctitle.c
compat/vis.c
compat/unvis.c
"

# Add platform-specific compat sources.
COMPAT_SOURCES="$COMPAT_SOURCES $EXTRA_COMPAT"

# Add compat sources for probed-absent functions.
test "$HAVE_EXPLICIT_BZERO" = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/explicit_bzero.c"
test "$HAVE_B64_NTOP"       = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/base64.c"
test "$HAVE_FGETLN"         = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/fgetln.c"
test "$HAVE_GETPEEREID"     = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/getpeereid.c"
test "$HAVE_GETPROGNAME"    = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/getprogname.c"
test "$HAVE_STRLCAT"        = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/strlcat.c"
test "$HAVE_STRLCPY"        = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/strlcpy.c"
test "$HAVE_STRTONUM"       = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/strtonum.c"
test "$HAVE_REALLOCARRAY"   = no && COMPAT_SOURCES="$COMPAT_SOURCES compat/reallocarray.c"
COMPAT_SOURCES="$COMPAT_SOURCES compat/utf8proc.c"

EXTRA_SOURCES="$OSDEP"

# Create build directories.
mkdir -p build/compat

# Generate build.ninja.
{
	cat <<NINJAEOF
# Generated by ./configure. Do not edit.
ninja_required_version = 1.3

cc = $CC
cflags = $CFLAGS_BASE $CPPFLAGS_ALL $TMUX_DEFS
ldflags = $LDFLAGS_ALL
libs = $LIBS_ALL
yacc = $YACC

rule cc
  command = \$cc -MMD -MF \$out.d \$cflags -c \$in -o \$out
  depfile = \$out.d
  deps = gcc
  description = CC \$in

rule link
  command = \$cc \$ldflags -o \$out \$in \$libs
  description = LINK \$out

rule yacc
  command = \$yacc -d -o \$out \$in
  description = YACC \$in

rule install
  command = mkdir -p \$destdir$PREFIX/bin && cp \$in \$destdir$PREFIX/bin/tmux && echo installed \$destdir$PREFIX/bin/tmux
  description = INSTALL \$in

# Parser generation.
build cmd-parse.c | cmd-parse.h: yacc cmd-parse.y

NINJAEOF

	# Build statements for each source file.
	OBJECTS=""

	emit_obj() {
		_src=$1
		_obj="build/$(printf '%s' "$_src" | sed 's|/|_|g;s|\.c$|.o|')"
		printf 'build %s: cc %s\n' "$_obj" "$_src"
		OBJECTS="$OBJECTS $_obj"
	}

	printf '# Core sources.\n'
	for src in $CORE_SOURCES; do
		emit_obj "$src"
	done

	printf '\n# Generated sources.\n'
	emit_obj cmd-parse.c
	for src in $EXTRA_SOURCES; do
		emit_obj "$src"
	done

	printf '\n# Compat sources.\n'
	for src in $COMPAT_SOURCES; do
		emit_obj "$src"
	done

	printf '\n# Link.\nbuild tmux: link%s\n' "$OBJECTS"
	printf '\ndefault tmux\n'

	printf '\n# Install.\nbuild install: install tmux\n'
} > build.ninja
printf 'generated build.ninja\n'

printf '\nready: ninja|samu\n'
